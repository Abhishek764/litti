# --- Litti ---
APPROVAL_SERVER_PORT=3847
# Signs approval tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string
# Required header (x-litti-key) for the agent/pipeline/CLI API. Strongly recommended.
LITTI_API_KEY=
# Required header (x-litti-admin-key) to issue review links. Keep it away from agents.
LITTI_ADMIN_KEY=
# Public base URL used in review links (e.g. https://litti.yourco.com)
PUBLIC_URL=

# --- Notifications ---
# Slack or Discord incoming webhook(s) for approval cards and updates. Comma-separate several.
LITTI_NOTIFY_WEBHOOK=

# --- Optional (see README "Running it for your company") ---
# LITTI_DB_PATH=data/litti.db
# LITTI_DEPLOY_DIR=deployments
# LITTI_DEPLOY_WEBHOOK=
# LITTI_WEBHOOK_SECRET=
# LITTI_IDENTITY_HEADER=
# LITTI_ALLOW_SELF_ASSERTED=
# LITTI_URL=http://127.0.0.1:3847
# HOST=
# LOG_LEVEL=
# TRUST_PROXY=
