# --- Litti ---
APPROVAL_SERVER_PORT=3847
# Signs approval tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional: require coding agents to send this as the x-litti-key header on POST /api/actions
LITTI_API_KEY=
# Optional: public base URL used in approval links posted to the room (e.g. https://litti.yourco.com)
PUBLIC_URL=

# --- Switch ---
# Agent bridge address ("Server address" in Switch Console). Local server default:
SWITCH_API_URL=http://127.0.0.1:64300
# First run only: Switch Console -> Settings -> API keys -> Create Registration Key.
# Litti registers itself as the @litti agent and saves its own credentials to .litti-switch.json.
SWITCH_REGISTRATION_KEY=
# Optional: room to post into. Defaults to the first room @litti is in, then follows whichever room mentions it.
SWITCH_ROOM_ID=
# Optional: agent name in the room (default: litti)
SWITCH_AGENT_NAME=litti

# --- Optional (see README "Running it for your company") ---
# LITTI_DB_PATH=data/litti.db
# LITTI_DEPLOY_DIR=deployments
# LITTI_DEPLOY_WEBHOOK=
# LITTI_WEBHOOK_SECRET=
# LITTI_IDENTITY_HEADER=
# LITTI_ALLOW_SELF_ASSERTED=
# HOST=
# LOG_LEVEL=
# TRUST_PROXY=
