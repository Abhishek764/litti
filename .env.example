# --- Litti ---
APPROVAL_SERVER_PORT=3847
# Signs approval tokens. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string
# Required header (x-litti-key) for the agent/pipeline/CLI API. Strongly recommended.
LITTI_API_KEY=
# Required header (x-litti-admin-key) to issue review links. Keep it away from agents.
LITTI_ADMIN_KEY=
# Public base URL used in review links (e.g. https://litti.yourco.com)
PUBLIC_URL=

# --- Notifications ---
# Slack or Discord incoming webhook(s) for approval cards and updates. Comma-separate several.
LITTI_NOTIFY_WEBHOOK=
# Slack app: bot token with chat:write, invited to the channel (name or id).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Discord channel webhook (https://discord.com/api/webhooks/...).
LITTI_DISCORD_WEBHOOK=
# Jira: issue per action at JIRA_MIN_TIER+ (default 2). JIRA_EMAIL only for Jira Cloud.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_API_TOKEN=
JIRA_EMAIL=
# JIRA_ISSUE_TYPE=Task
# JIRA_MIN_TIER=2
# JIRA_DONE_TRANSITION=Done

# --- Optional (see README "Running it for your company") ---
# LITTI_DB_PATH=data/litti.db
# LITTI_DEPLOY_DIR=deployments
# LITTI_DEPLOY_WEBHOOK=
# LITTI_WEBHOOK_SECRET=
# LITTI_IDENTITY_HEADER=
# LITTI_ALLOW_SELF_ASSERTED=
# LITTI_URL=http://127.0.0.1:3847
# HOST=
# LOG_LEVEL=
# TRUST_PROXY=
# Comprehension check kinds (default all): quiz,spot-line,type-in,canary,count,explain
# LITTI_CHALLENGES=

# --- Changes view (/changes) ---
# Git repository to watch (default: where the server runs).
# LITTI_REPO_PATH=
# Name for agent replies and actions sent from the Changes view.
# LITTI_AGENT_NAME=agent

# --- Agent hooks (litti install claude|codex|opencode) ---
# LITTI_URL=http://127.0.0.1:3847
# Don't gate git commit (push, deploy, publish, migrations stay gated).
# LITTI_GATE_COMMIT=false
# Extra commands to gate: regexes separated by ;;
# LITTI_GATE_PATTERNS=^make release;;^./deploy.sh
# Allow commands when the Litti server is down (default: block). Not for production.
# LITTI_HOOK_FAIL_OPEN=false

# --- Connect buttons (/integrations) ---
# Who can manage integrations in production (SSO identities, comma-separated).
# LITTI_ADMINS=you@yourco.com
# Optional: OAuth app credentials here instead of pasting them on the Integrations page.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
