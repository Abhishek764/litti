{
  "name": "litti-cli",
  "version": "0.4.0",
  "description": "Proof of review for AI coding agents: risk tiering, comprehension quizzes, rubber-stamp detection, diff-bound tokens, tamper-evident receipts.",
  "type": "module",
  "bin": {
    "litti": "dist/main.js"
  },
  "files": [
    "dist",
    "public",
    "docs/guide",
    "demo/sample-diffs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "demo": "tsx src/demo.ts",
    "litti": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && tsx test/smoke.ts && tsx test/production.ts && tsx test/cli.ts && tsx test/notify.ts && tsx test/challenges.ts && tsx test/changes.ts && tsx test/hooks.ts && tsx test/connect.ts && tsx test/docs.ts && tsx test/broker.ts && tsx test/security.ts && tsx test/site.ts && tsx test/ui.ts && tsx test/logging.ts && tsx test/privacy.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "site": "tsx scripts/build-site.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.1.0",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Abhishek764 (https://github.com/Abhishek764)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishek764/litti.git"
  },
  "homepage": "https://github.com/Abhishek764/litti#readme",
  "bugs": {
    "url": "https://github.com/Abhishek764/litti/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "ai-agents",
    "human-in-the-loop",
    "approval",
    "audit-log",
    "hash-chain",
    "security",
    "code-review",
    "claude-code",
    "proof-of-review"
  ]
}
