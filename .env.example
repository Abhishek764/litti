# Litti settings for Docker (team server) or running from source.
# The installed `litti` command uses ~/.litti/config.env instead and fills in the keys for you.
# Every option: docs/guide/config.md

# --- Required for a team server ---
# Each one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs approval tokens, review links and page stamps; encrypts integration tokens.
SECRET_KEY=change-me-to-a-long-random-string
# Agents, CLI and pipelines send it as x-litti-key. Required whenever HOST is not 127.0.0.1 (Docker).
LITTI_API_KEY=
# Or one labelled key per agent; the label becomes the requester: ci-bot:key1,claude-ana:key2
# LITTI_API_KEYS=
# Issues personal review links (x-litti-admin-key). Keep it away from agents.
LITTI_ADMIN_KEY=
# Base URL in review links. Required when an agent key is set, e.g. https://litti.yourco.com
PUBLIC_URL=

# --- Sign-in behind your SSO proxy ---
# TRUST_PROXY=true
# LITTI_IDENTITY_HEADER=x-forwarded-email
# Who can manage /integrations (SSO identities, comma-separated).
# LITTI_ADMINS=you@yourco.com

# --- Server ---
# APPROVAL_SERVER_PORT=3847
# HOST=127.0.0.1
# LOG_LEVEL=info
# LITTI_DB_PATH=data/litti.db
# Comprehension check kinds (default all): quiz,spot-line,type-in,canary,count,explain
# LITTI_CHALLENGES=
# Local mode only: who you are when reviewing on this machine (default: your OS user name).
# LITTI_LOCAL_REVIEWER=
# Demo only: let reviewers type a name.
# LITTI_ALLOW_SELF_ASSERTED=

# --- Running approved actions ---
# LITTI_DEPLOY_WEBHOOK=
# LITTI_WEBHOOK_SECRET=
# LITTI_WEBHOOK_TIMEOUT_MS=15000
# LITTI_DEPLOY_DIR=deployments

# --- Notifications (or use the Integrations page) ---
# Slack or Discord incoming webhook(s), comma-separated.
LITTI_NOTIFY_WEBHOOK=
# Slack app: bot token with chat:write, invited to the channel (name or id).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Discord channel webhook (https://discord.com/api/webhooks/...).
LITTI_DISCORD_WEBHOOK=
# Jira: one issue per action at JIRA_MIN_TIER and up (default 2). JIRA_EMAIL only for Jira Cloud.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_API_TOKEN=
JIRA_EMAIL=
# JIRA_ISSUE_TYPE=Task
# JIRA_MIN_TIER=2
# JIRA_DONE_TRANSITION=Done

# --- Connect buttons (/integrations) ---
# One-click connect through a Litti Connect service (docs/connect-service.md). Unset or "off": disabled.
# LITTI_CONNECT_BROKER=
# Your own OAuth apps, instead of pasting them on the Integrations page.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=

# --- Changes view (/changes) ---
# LITTI_REPO_PATH=
# LITTI_AGENT_NAME=agent

# --- Agent hooks: set these in ~/.litti/config.env on the agent's machine, not here ---
# LITTI_URL=http://127.0.0.1:3847
# LITTI_GATE_COMMIT=false
# LITTI_GATE_PATTERNS=^make release;;^./deploy.sh
# LITTI_HOOK_FAIL_OPEN=false
